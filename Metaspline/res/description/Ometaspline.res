CONTAINER Ometaspline
{
    NAME Ometaspline;
    INCLUDE Obase;
    GROUP ID_OBJECTPROPERTIES
    {
        REAL MS_COLLAPSE { UNIT METER; MIN 0; STEP 0.1; }
        REAL MS_FALLOW { UNIT METER; MIN 0; STEP 0.1; }
        REAL MS_VISCOSITY { UNIT PERCENT; MIN 0; MAX 100; MINSLIDER 0; MAXSLIDER 100; STEP 1; CUSTOMGUI REALSLIDER; }
        REAL MS_SMOOTH { UNIT PERCENT; MIN 0; MAX 100; MINSLIDER 0; MAXSLIDER 100; STEP 1; CUSTOMGUI REALSLIDER; }
        SEPARATOR {}
        STATICTEXT MS_STATUS {}
    }
}
