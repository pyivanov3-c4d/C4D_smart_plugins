CONTAINER Onoisespread
{
 NAME Onoisespread;
 INCLUDE Obase;
 GROUP ID_OBJECTPROPERTIES
 {
  REAL NS_SIZE { MIN 0; STEP 0.01; }
  REAL NS_FEATHER { MIN 0; MAX 0.99; MINSLIDER 0; MAXSLIDER 0.99; STEP 0.01; CUSTOMGUI REALSLIDER; }
  SHADERLINK NS_NOISE { }
  STRING NS_SELECTION { }
  GROUP NS_ADVANCED
  {
   DEFAULT 0;
   LONG NS_SEED { MIN 0; MAX 2147483647; }
   LONG NS_LIMIT { MIN 1; MAX 20000; }
  }
  SEPARATOR { }
  STATICTEXT NS_STATUS { }
 }
}
