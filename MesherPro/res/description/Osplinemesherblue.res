CONTAINER Osplinemesherblue
{
    NAME Osplinemesherblue;
    INCLUDE Obase;
    GROUP ID_OBJECTPROPERTIES
    {
        BUTTON SMB_RESET_ALL {}
        LONG SMB_PROFILE { CYCLE { SMB_CIRCLE; SMB_RECTANGLE; SMB_ROPE; SMB_CHAIN; } }
        SEPARATOR {}
        REAL SMB_RADIUS { UNIT METER; MIN 0.001; STEP 0.1; }
        LONG SMB_CIRCLE_SEGMENTS { MIN 3; MAX 200; STEP 1; }
        REAL SMB_WIDTH { UNIT METER; MIN 0.001; STEP 0.1; }
        REAL SMB_HEIGHT { UNIT METER; MIN 0.001; STEP 0.1; }
        REAL SMB_FILLET { UNIT METER; MIN 0; STEP 0.1; }
        LONG SMB_FILLET_SEGMENTS { MIN 1; MAX 200; STEP 1; }
        BOOL SMB_CAPS {}
        REAL SMB_DIAMETER { UNIT METER; MIN 0.001; STEP 0.1; }
        SEPARATOR {}
        LONG SMB_ROTATIONS { MIN 0; MAX 10000; STEP 1; }
        REAL SMB_STEP { UNIT METER; MIN 0.1; STEP 0.1; }
        SPLINE SMB_WIDTH_CURVE {}
        GROUP SMB_GAPS_GROUP
        {
            DEFAULT 1;
            BOOL SMB_GAPS {}
            LONG SMB_GAP_MODE { CYCLE { SMB_INTERVAL; SMB_COUNT; } }
            REAL SMB_PIECE_LENGTH { UNIT METER; MIN 0.001; STEP 0.1; }
            LONG SMB_PIECE_COUNT { MIN 1; MAX 10000; STEP 1; }
            REAL SMB_SPACE_LENGTH { UNIT METER; STEP 0.1; }
            REAL SMB_PIECE_TILT_X { UNIT DEGREE; STEP 1; }
            REAL SMB_PIECE_TILT_Y { UNIT DEGREE; STEP 1; }
        }
        STATICTEXT SMB_STATUS {}
    }
}
