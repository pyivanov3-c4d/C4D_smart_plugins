CONTAINER Osmartsmooth
{
 NAME Osmartsmooth;
 INCLUDE Obase;
 GROUP ID_OBJECTPROPERTIES
 {
  LONG SS_ITERATIONS { MIN 0; MAX 6; STEP 1; }
  SEPARATOR {}
  REAL SS_WIDTH { UNIT METER; MIN 0; STEP 0.1; }
  LONG SS_BEVEL_SUB { MIN 0; MAX 64; STEP 1; }
  REAL SS_ROUNDNESS { MIN -1; MAX 1; STEP 0.01; }
 }
}
